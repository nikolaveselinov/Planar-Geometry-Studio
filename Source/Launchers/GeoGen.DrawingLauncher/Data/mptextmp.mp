btex \vbox{Let~$ABC$ be a~triangle. Let~$D$ be the projection of~$A$ on~$BC$. Let~$E$ be the projection of~$B$ on~$AC$. Let~$F$ be the projection of~$C$ on~$AB$. Let~$G$ be the circumcenter of~$ABD$. \par Show that points~$D,E,F,G$ are concyclic. \par\noindent\medskip \tabskip=0pt\halign to \hsize{\tabskip0pt plus1fil\hfil#\hfil&\tabskip0pt plus1fil\hfil#\hfil&\tabskip0pt plus1fil\hfil#\hfil&\tabskip0pt\hfil#\hfil\cr Type&Ranking&Weight&Contribution\cr \noalign{\vskip2pt\hrule\vskip3pt}Level&$0.88$&$1000$&$884.62$\cr Symmetry&$0$&$10000$&$0$\cr Number of theorems&$28$&$-1$&$-28$\cr Cyclic quadrilaterals&$3$&$-10$&$-30$\cr }\par\medskip Total ranking: $826.62$} etex
