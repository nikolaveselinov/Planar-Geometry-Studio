<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>true</ImplicitUsings>
		<Nullable>enable</Nullable>
		<AssemblyName>PlanarGeometryStudio</AssemblyName>
		<ApplicationIcon>../../../packaging/assets/studio.ico</ApplicationIcon>
		<RootNamespace>GeoGen.DesktopApp</RootNamespace>
		<BuiltInComInteropSupport>true</BuiltInComInteropSupport>
		<AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
		<VersionPrefix>1.2.4</VersionPrefix>
		<AssemblyVersion>1.2.4.0</AssemblyVersion>
		<FileVersion>1.2.4.0</FileVersion>
		<Authors>Nikola Veselinov</Authors>
		<Company>Nikola Veselinov</Company>
		<Copyright>Copyright © Nikola Veselinov</Copyright>
		<Description>A desktop application for generating, proving, ranking, and drawing planar geometry theorems.</Description>
		<RepositoryUrl>https://github.com/nikolaveselinov/Planar-Geometry-Studio</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageLicenseExpression>AGPL-3.0-only</PackageLicenseExpression>
		<EnableNETAnalyzers>true</EnableNETAnalyzers>
		<AnalysisLevel>latest-recommended</AnalysisLevel>
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="../../Library/GeoGen.Core/GeoGen.Core.csproj" />
		<EmbeddedResource Include="Services/ConstructionDescriptions.json" LogicalName="GeoGen.DesktopApp.ConstructionDescriptions.json" />
		<EmbeddedResource Include="../../../TERMS.md" LogicalName="GeoGen.DesktopApp.Terms.md" />
		<Content Include="../../../packaging/setup/*" Link="setup/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
		<PackageReference Include="Avalonia" />
		<PackageReference Include="Avalonia.Desktop" />
		<PackageReference Include="Avalonia.Themes.Fluent" />
		<PackageReference Include="Avalonia.Fonts.Inter" />
	</ItemGroup>

</Project>
