<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="GeoGen.DesktopApp.Views.UnsavedChangesDialog"
        Title="Unsaved changes"
        Width="500"
        SizeToContent="Height"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <Grid RowDefinitions="Auto,Auto" Margin="28">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="18">
            <Border Width="48" Height="48" CornerRadius="24" Background="#FFF4D6">
                <TextBlock Text="!" FontSize="25" FontWeight="SemiBold"
                           Foreground="#8A5A00" HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
            </Border>

            <StackPanel Grid.Column="1" Spacing="8">
                <TextBlock Text="Save your changes?" FontSize="20" FontWeight="SemiBold" />
                <TextBlock x:Name="MessageText" TextWrapping="Wrap" Opacity="0.78" />
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right"
                    Spacing="10" Margin="0,28,0,0">
            <Button Content="Cancel" MinWidth="88" Click="CancelClicked" />
            <Button Content="Discard" MinWidth="88" Click="DiscardClicked" />
            <Button Content="Save" MinWidth="88" Classes="accent" Click="SaveClicked" />
        </StackPanel>
    </Grid>
</Window>
