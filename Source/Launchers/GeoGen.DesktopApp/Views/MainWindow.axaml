<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:GeoGen.DesktopApp.ViewModels"
        x:Class="GeoGen.DesktopApp.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding WindowTitle}"
        Width="1400" Height="800"
        MinWidth="800" MinHeight="500"
        WindowStartupLocation="CenterScreen">

    <Window.Styles>
        <!-- Override Fluent theme hover/focus backgrounds on the output TextBox so it stays dark -->
        <Style Selector="TextBox#OutputBox /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="#1E1E1E" />
            <Setter Property="BorderBrush" Value="#333333" />
        </Style>
        <Style Selector="TextBox#OutputBox:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="#1E1E1E" />
            <Setter Property="BorderBrush" Value="#333333" />
        </Style>
        <Style Selector="TextBox#OutputBox:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="#1E1E1E" />
            <Setter Property="BorderBrush" Value="#555555" />
        </Style>
        <Style Selector="TextBox#OutputBox:focus-within /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="#1E1E1E" />
            <Setter Property="BorderBrush" Value="#555555" />
        </Style>
    </Window.Styles>

    <Window.KeyBindings>
        <KeyBinding Gesture="F5" Command="{Binding GenerateCommand}" />
        <KeyBinding Gesture="Ctrl+N" Command="{Binding NewCommand}" />
        <KeyBinding Gesture="Ctrl+O" Command="{Binding OpenCommand}" />
        <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveCommand}" />
        <KeyBinding Gesture="Ctrl+Shift+S" Command="{Binding SaveAsCommand}" />
    </Window.KeyBindings>

    <DockPanel>
        <!-- Menu Bar -->
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_New" Command="{Binding NewCommand}" InputGesture="Ctrl+N" />
                <MenuItem Header="_Open..." Command="{Binding OpenCommand}" InputGesture="Ctrl+O" />
                <Separator />
                <MenuItem Header="_Save" Command="{Binding SaveCommand}" InputGesture="Ctrl+S" />
                <MenuItem Header="Save _As..." Command="{Binding SaveAsCommand}" InputGesture="Ctrl+Shift+S" />
                <Separator />
                <MenuItem Header="E_xit" Command="{Binding ExitCommand}" />
            </MenuItem>
            <MenuItem Header="_Run">
                <MenuItem Header="_Generate Problems" Command="{Binding GenerateCommand}" InputGesture="F5" />
                <MenuItem Header="Generate _Figures" Command="{Binding FiguresCommand}" />
                <MenuItem Header="_Stop" Command="{Binding StopCommand}" />
                <Separator />
                <MenuItem Header="_Open Output Folder" Command="{Binding OpenOutputFolderCommand}" />
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem Header="_Clear Output" Command="{Binding ClearOutputCommand}" />
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_Quick Start" Command="{Binding QuickStartCommand}" />
                <MenuItem Header="_Reference" Command="{Binding ReferenceCommand}" />
                <Separator />
                <MenuItem Header="_About" Command="{Binding AboutCommand}" />
            </MenuItem>
        </Menu>

        <!-- Toolbar -->
        <Border DockPanel.Dock="Top" Background="#F0F0F0" Padding="4">
            <StackPanel Orientation="Horizontal" Spacing="4">
                <Button Content="New" Command="{Binding NewCommand}" Padding="8,4" />
                <Button Content="Open" Command="{Binding OpenCommand}" Padding="8,4" />
                <Button Content="Save" Command="{Binding SaveCommand}" Padding="8,4" />
                <Border Width="1" Background="#CCC" Margin="4,2" />
                <Button Content="Generate Problems" Command="{Binding GenerateCommand}"
                        Padding="12,4" FontWeight="Bold" />
                <Button Content="Stop" Command="{Binding StopCommand}" Padding="8,4" />
                <Border Width="1" Background="#CCC" Margin="4,2" />
                <Button Content="Generate Figures" Command="{Binding FiguresCommand}" Padding="8,4" />
                <Button Content="Open Output Folder" Command="{Binding OpenOutputFolderCommand}" Padding="8,4" />
            </StackPanel>
        </Border>

        <!-- Status Bar -->
        <Border DockPanel.Dock="Bottom" Background="#F0F0F0" Padding="8,4">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="{Binding CurrentFileName}" Opacity="0.6" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{Binding StatusText}" />
                    <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsRunning}"
                                 Width="100" Height="8" VerticalAlignment="Center" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Main Content -->
        <Grid ColumnDefinitions="*,4,*">
            <!-- Left: Input Editor -->
            <DockPanel Grid.Column="0">
                <Border DockPanel.Dock="Top" Background="#E8E8E8" Padding="8,4">
                    <TextBlock Text="Input Configuration" FontWeight="SemiBold" />
                </Border>
                <TextBox Text="{Binding InputText}"
                         AcceptsReturn="True"
                         AcceptsTab="True"
                         TextWrapping="NoWrap"
                         FontFamily="Consolas, Courier New, monospace"
                         FontSize="13" />
            </DockPanel>

            <!-- Splitter -->
            <GridSplitter Grid.Column="1" ResizeDirection="Columns" Background="#CCC" />

            <!-- Right: Output Console -->
            <DockPanel Grid.Column="2">
                <Border DockPanel.Dock="Top" Background="#2D2D2D" Padding="8,4">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Clear"
                                Command="{Binding ClearOutputCommand}"
                                Padding="8,2" FontSize="11" />
                        <TextBlock Text="Output" FontWeight="SemiBold" Foreground="#CCC" />
                    </DockPanel>
                </Border>
                <TextBox Name="OutputBox"
                         Text="{Binding OutputText}"
                         IsReadOnly="True"
                         AcceptsReturn="True"
                         TextWrapping="NoWrap"
                         FontFamily="Consolas, Courier New, monospace"
                         FontSize="12"
                         Background="#1E1E1E"
                         Foreground="#DCDCDC"
                         BorderBrush="#333333"
                         CaretBrush="#DCDCDC" />
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
