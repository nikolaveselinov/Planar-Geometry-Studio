<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:GeoGen.DesktopApp.ViewModels"
        x:Class="GeoGen.DesktopApp.Views.MainWindow" x:DataType="vm:MainWindowViewModel"
        Title="{Binding WindowTitle}" Width="1360" Height="860" MinWidth="960" MinHeight="620"
        Background="#252526" WindowStartupLocation="CenterScreen">
    <Window.KeyBindings>
        <KeyBinding Gesture="Ctrl+K" Command="{Binding ConstructionsCommand}" />
        <KeyBinding Gesture="Ctrl+N" Command="{Binding NewCommand}" />
        <KeyBinding Gesture="Ctrl+O" Command="{Binding OpenCommand}" />
        <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveCommand}" />
        <KeyBinding Gesture="Ctrl+Shift+S" Command="{Binding SaveAsCommand}" />
        <KeyBinding Gesture="F5" Command="{Binding GenerateCommand}" />
        <KeyBinding Gesture="Ctrl+Enter" Command="{Binding GenerateCommand}" />
        <KeyBinding Gesture="Escape" Command="{Binding StopCommand}" />
    </Window.KeyBindings>

    <Window.Styles>
        <Style Selector="Button.toolbar">
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="CornerRadius" Value="2" />
        </Style>
        <Style Selector="TextBox.editor">
            <Setter Property="Background" Value="#1E1E1E" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Foreground" Value="#D4D4D4" />
            <Setter Property="SelectionBrush" Value="#264F78" />
            <Setter Property="CaretBrush" Value="#D4D4D4" />
        </Style>
    </Window.Styles>
    <DockPanel>
        <Menu DockPanel.Dock="Top" Background="#252526" Padding="8,2">
            <MenuItem Header="_File">
                <MenuItem Header="_New" Command="{Binding NewCommand}" InputGesture="Ctrl+N" />
                <MenuItem Header="_Open…" Command="{Binding OpenCommand}" InputGesture="Ctrl+O" />
                <Separator />
                <MenuItem Header="_Save" Command="{Binding SaveCommand}" InputGesture="Ctrl+S" />
                <MenuItem Header="Save _As…" Command="{Binding SaveAsCommand}" InputGesture="Ctrl+Shift+S" />
                <Separator />
                <MenuItem Header="Open _Results" Command="{Binding OpenOutputFolderCommand}" />
                <Separator />
                <MenuItem Header="E_xit" Command="{Binding ExitCommand}" />
            </MenuItem>
            <MenuItem Header="_Run">
                <MenuItem Header="_Generate" Command="{Binding GenerateCommand}" InputGesture="F5" />
                <MenuItem Header="_Stop" Command="{Binding StopCommand}" InputGesture="Escape" />
                <Separator />
                <MenuItem Header="_Figures…" Command="{Binding FiguresCommand}" />
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_Quick Start" Command="{Binding QuickStartCommand}" />
                <MenuItem Header="_Constructions…" Command="{Binding ConstructionsCommand}" InputGesture="Ctrl+K" />
                <MenuItem Header="Input _Reference" Command="{Binding ReferenceCommand}" />
                <MenuItem Header="Studio _Setup…" Command="{Binding StudioSetupCommand}" />
                <MenuItem Header="Check for _Updates" Command="{Binding CheckForUpdatesCommand}" />
                <Separator />
                <MenuItem Header="_About" Command="{Binding AboutCommand}" />
            </MenuItem>
        </Menu>

        <Border DockPanel.Dock="Top" Background="#2A2D2E" Padding="16,9" BorderBrush="#3C3C3C" BorderThickness="0,0,0,1"
                IsVisible="{Binding ShowUpdateNotice}">
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
                <TextBlock Text="{Binding UpdateNotice}" VerticalAlignment="Center" TextWrapping="Wrap" />
                <Button Grid.Column="1" Content="Download installer" Command="{Binding DownloadUpdateCommand}" IsVisible="{Binding HasUpdate}" />
                <Button Grid.Column="2" Content="Dismiss" Command="{Binding DismissUpdateCommand}" />
            </Grid>
        </Border>
        <Border DockPanel.Dock="Top" BorderBrush="#3C3C3C" BorderThickness="0,1,0,1" Padding="12,8">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Classes="toolbar" Content="New" Command="{Binding NewCommand}" ToolTip.Tip="New (Ctrl+N)" />
                <Button Classes="toolbar" Content="Open…" Command="{Binding OpenCommand}" ToolTip.Tip="Open (Ctrl+O)" />
                <Button Classes="toolbar" Content="Save" Command="{Binding SaveCommand}" ToolTip.Tip="Save (Ctrl+S)" />
                <Border Width="1" Height="24" Background="#3C3C3C" Margin="6,0" />
                <Button Classes="toolbar" Content="Generate" Command="{Binding GenerateCommand}" ToolTip.Tip="Generate (F5)" />
                <Button Classes="toolbar" Content="Stop" Command="{Binding StopCommand}" ToolTip.Tip="Stop (Esc)" />
                <Button Classes="toolbar" Content="Figures…" Command="{Binding FiguresCommand}" />
            </StackPanel>
        </Border>
        <Border DockPanel.Dock="Bottom" BorderBrush="#3C3C3C" BorderThickness="0,1,0,0" Padding="12,7">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <TextBlock Text="{Binding StatusText}" FontSize="12" />
                    <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsRunning}" Width="70" Height="3" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding WorkspaceText}" FontSize="12" Foreground="#A0A0A0"
                           HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="2" Text="{Binding CurrentFileName}" FontSize="12" Foreground="#A0A0A0" />
            </Grid>
        </Border>
        <Grid Margin="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="6*" MinWidth="360" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="5*" MinWidth="340" />
            </Grid.ColumnDefinitions>
            <Border Background="#1E1E1E" BorderBrush="#3C3C3C" BorderThickness="1">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="#252526" BorderBrush="#3C3C3C" BorderThickness="0,0,0,1" Padding="12,8">
                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
                            <TextBlock Text="Input" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding InputStatistics}" FontSize="11" Foreground="#A0A0A0" VerticalAlignment="Center" />
                            <Button Grid.Column="2" Classes="toolbar" Content="Constructions…" Command="{Binding ConstructionsCommand}"
                                    ToolTip.Tip="Browse all constructions (Ctrl+K)" />
                        </Grid>
                    </Border>
                    <TextBox x:Name="EditorBox" Classes="editor" Text="{Binding InputText, Mode=TwoWay}"
                             AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap"
                             FontFamily="Cascadia Code,Consolas,monospace" FontSize="14" LineHeight="21"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto" />
                </DockPanel>
            </Border>
            <GridSplitter Grid.Column="1" Background="Transparent" ResizeDirection="Columns" Margin="2,0" />
            <Border Grid.Column="2" Background="#1E1E1E" BorderBrush="#3C3C3C" BorderThickness="1">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="#252526" BorderBrush="#3C3C3C" BorderThickness="0,0,0,1" Padding="12,8">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="Output" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                <Button Classes="toolbar" Content="Clear" Command="{Binding ClearOutputCommand}" />
                                <Button Classes="toolbar" Content="Open Results" Command="{Binding OpenOutputFolderCommand}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <TextBox x:Name="OutputBox" Classes="editor" Text="{Binding OutputText, Mode=OneWay}"
                             IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                             FontFamily="Cascadia Code,Consolas,monospace" FontSize="12.5" LineHeight="19"
                             PlaceholderText="Output appears here." ScrollViewer.VerticalScrollBarVisibility="Auto" />
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
