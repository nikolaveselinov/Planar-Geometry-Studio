<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:GeoGen.DesktopApp.ViewModels"
        x:Class="GeoGen.DesktopApp.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding WindowTitle}"
        Width="1400" Height="900"
        MinWidth="800" MinHeight="500"
        WindowStartupLocation="CenterScreen">

    <Window.KeyBindings>
        <KeyBinding Gesture="Ctrl+N" Command="{Binding NewCommand}" />
        <KeyBinding Gesture="Ctrl+O" Command="{Binding OpenCommand}" />
        <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveCommand}" />
        <KeyBinding Gesture="Ctrl+Shift+S" Command="{Binding SaveAsCommand}" />
        <KeyBinding Gesture="F5" Command="{Binding GenerateCommand}" />
    </Window.KeyBindings>

    <Window.Styles>
        <!-- Toolbar button style -->
        <Style Selector="Button.toolbar">
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Margin" Value="1" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="CornerRadius" Value="3" />
        </Style>
        <Style Selector="Button.toolbar-primary">
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="Margin" Value="1" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Background" Value="#4CAF50" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="Button.toolbar-primary:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#45A049" />
        </Style>
        <Style Selector="Button.toolbar-danger">
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Margin" Value="1" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Background" Value="#E53935" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="Button.toolbar-danger:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#C62828" />
        </Style>
        <Style Selector="Button.toolbar-accent">
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="Margin" Value="1" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Background" Value="#1976D2" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="Button.toolbar-accent:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#1565C0" />
        </Style>

        <!-- Force dark background on console output in all states -->
        <Style Selector="TextBox#OutputBox /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="#1E1E1E" />
        </Style>
        <Style Selector="TextBox#OutputBox:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="#1E1E1E" />
        </Style>
        <Style Selector="TextBox#OutputBox:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="#1E1E1E" />
        </Style>
        <Style Selector="TextBox#OutputBox:focus-within /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="#1E1E1E" />
        </Style>
    </Window.Styles>

    <DockPanel>
        <!-- Menu Bar -->
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_New" Command="{Binding NewCommand}" InputGesture="Ctrl+N" />
                <MenuItem Header="_Open..." Command="{Binding OpenCommand}" InputGesture="Ctrl+O" />
                <Separator />
                <MenuItem Header="_Save" Command="{Binding SaveCommand}" InputGesture="Ctrl+S" />
                <MenuItem Header="Save _As..." Command="{Binding SaveAsCommand}" InputGesture="Ctrl+Shift+S" />
                <Separator />
                <MenuItem Header="Open _Output Folder" Command="{Binding OpenOutputFolderCommand}" />
                <Separator />
                <MenuItem Header="E_xit" Command="{Binding ExitCommand}" />
            </MenuItem>
            <MenuItem Header="_Run">
                <MenuItem Header="_Generate Problems" Command="{Binding GenerateCommand}" InputGesture="F5" />
                <MenuItem Header="_Stop" Command="{Binding StopCommand}" />
                <Separator />
                <MenuItem Header="Generate _Figures..." Command="{Binding FiguresCommand}" />
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_Quick Start Guide" Command="{Binding QuickStartCommand}" />
                <MenuItem Header="_Reference (Constructions and Parameters)" Command="{Binding ReferenceCommand}" />
                <Separator />
                <MenuItem Header="_About" Command="{Binding AboutCommand}" />
            </MenuItem>
        </Menu>

        <!-- Toolbar -->
        <Border DockPanel.Dock="Top" Background="#F5F5F5" BorderBrush="#E0E0E0"
                BorderThickness="0,0,0,1" Padding="6,4">
            <StackPanel Orientation="Horizontal" Spacing="3">
                <Button Classes="toolbar" Content="New" Command="{Binding NewCommand}"
                        ToolTip.Tip="New file (Ctrl+N)" />
                <Button Classes="toolbar" Content="Open" Command="{Binding OpenCommand}"
                        ToolTip.Tip="Open file (Ctrl+O)" />
                <Button Classes="toolbar" Content="Save" Command="{Binding SaveCommand}"
                        ToolTip.Tip="Save file (Ctrl+S)" />

                <Border Width="1" Background="#D0D0D0" Margin="6,2" />

                <Button Classes="toolbar-primary" Content="&#x25B6; Generate Problems"
                        Command="{Binding GenerateCommand}"
                        ToolTip.Tip="Generate problems (F5)" />
                <Button Classes="toolbar-danger" Content="&#x25A0; Stop"
                        Command="{Binding StopCommand}"
                        ToolTip.Tip="Stop generation" />

                <Border Width="1" Background="#D0D0D0" Margin="6,2" />

                <Button Classes="toolbar-accent" Content="Generate Figures"
                        Command="{Binding FiguresCommand}"
                        ToolTip.Tip="Generate and convert figures to PDF" />

                <Border Width="1" Background="#D0D0D0" Margin="6,2" />

                <Button Classes="toolbar" Content="Clear Output"
                        Command="{Binding ClearOutputCommand}" />
                <Button Classes="toolbar" Content="Open Output Folder"
                        Command="{Binding OpenOutputFolderCommand}" />

                <Border Width="1" Background="#D0D0D0" Margin="6,2" />

                <Button Classes="toolbar" Content="Quick Start"
                        Command="{Binding QuickStartCommand}"
                        ToolTip.Tip="Show quick start guide" />
                <Button Classes="toolbar" Content="Reference"
                        Command="{Binding ReferenceCommand}"
                        ToolTip.Tip="Show all constructions and parameters" />
            </StackPanel>
        </Border>

        <!-- Status Bar -->
        <Border DockPanel.Dock="Bottom" Background="#007ACC" Padding="10,4" MinHeight="28">
            <Grid>
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock Text="{Binding StatusText}" Foreground="White"
                               FontSize="12" VerticalAlignment="Center" />
                    <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsRunning}"
                                 Width="120" Height="3" VerticalAlignment="Center"
                                 Foreground="White" Background="#005A9E" />
                </StackPanel>
                <TextBlock Text="{Binding CurrentFileName}" Foreground="#B0D4F1"
                           FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- Main Content: Split View -->
        <Grid ColumnDefinitions="*,5,*">

            <!-- Left Panel: Code Editor -->
            <DockPanel Grid.Column="0">
                <Border DockPanel.Dock="Top" Background="#E8E8E8" Padding="10,5"
                        BorderBrush="#D0D0D0" BorderThickness="0,0,0,1">
                    <TextBlock Text="Input Configuration" FontWeight="SemiBold" FontSize="13" />
                </Border>
                <TextBox x:Name="EditorBox"
                         Text="{Binding InputText, Mode=TwoWay}"
                         AcceptsReturn="True"
                         AcceptsTab="True"
                         TextWrapping="NoWrap"
                         FontFamily="Cascadia Code,Consolas,Courier New,monospace"
                         FontSize="14"
                         Padding="10"
                         BorderThickness="0" />
            </DockPanel>

            <!-- Splitter -->
            <GridSplitter Grid.Column="1" Background="#CCCCCC"
                          ResizeDirection="Columns" />

            <!-- Right Panel: Console Output -->
            <DockPanel Grid.Column="2">
                <Border DockPanel.Dock="Top" Background="#1E1E1E" Padding="10,5"
                        BorderBrush="#333333" BorderThickness="0,0,0,1">
                    <TextBlock Text="Console Output" Foreground="#CCCCCC"
                               FontWeight="SemiBold" FontSize="13" />
                </Border>
                <TextBox x:Name="OutputBox"
                         Text="{Binding OutputText, Mode=OneWay}"
                         IsReadOnly="True"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         FontFamily="Cascadia Code,Consolas,Courier New,monospace"
                         FontSize="12"
                         Background="#1E1E1E"
                         Foreground="#D4D4D4"
                         Padding="10"
                         BorderThickness="0"
                         Watermark="Output will appear here when you run generation..." />
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
