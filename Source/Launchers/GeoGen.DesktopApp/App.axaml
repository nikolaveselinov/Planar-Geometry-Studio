<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="GeoGen.DesktopApp.App"
             RequestedThemeVariant="Dark">
    <Application.Styles>
        <FluentTheme>
            <FluentTheme.Palettes>
                <ColorPaletteResources x:Key="Dark" Accent="#007ACC" RegionColor="#252526" />
            </FluentTheme.Palettes>
        </FluentTheme>
    </Application.Styles>
</Application>
